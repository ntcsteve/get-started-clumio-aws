# Step 0 reads this file. After any change, run step 0 again, so what you create is what was approved.
account_id = "ACCOUNT-ID-REPLACE-THIS" # your 12-digit AWS account ID; Terraform stops if you're signed in to another account
region     = "REGION-REPLACE-THIS"     # where your data is, such as ap-southeast-1

iam_prefix = ""         # such as "platform-clumio", if your IAM names must start with a prefix
iam_path   = "/clumio/" # "/" if your naming rule allows no path
workloads  = ["s3"]     # add "rds" for RDS and Aurora, or "ebs" for EC2 and EBS

# Optional: who gets Clumio's daily compliance report for this Region (not yet tested live)
# report_emails = ["platform-oncall@example.com"]

# Only if your organization requires them (see SECURITY.md):
# role_tags                = { team = "platform" }
# permissions_boundary_arn = "arn:aws:iam::<account>:policy/<boundary>"
# pass_role_deny_list      = ["arn:aws:iam::<account>:role/<role Clumio must never pass>"]
