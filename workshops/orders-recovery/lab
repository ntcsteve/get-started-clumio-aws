# The RDS Data API's answers for a cluster that can't take SQL yet: starting, without an instance,
# or without the Data API. Anything else (AccessDenied, a bad secret) is a real error and stops.
DATA_API_STARTING = ("DatabaseResumingException", "DatabaseUnavailableException", "HttpEndpointNotEnabledException",
                     "ServiceUnavailableError")  # answers that pass on their own, as the Data API starts
NOT_SERVING = ("BadRequestException", "DatabaseNotFoundException", "InvalidResourceStateException",
               "StatementTimeoutException")  # answers that don't pass on their own: the cluster can't take SQL
NOT_QUERYABLE = DATA_API_STARTING + NOT_SERVING


def describe_cluster(cluster_id):
    response = aws("rds", "describe-db-clusters", "--db-cluster-identifier", cluster_id, absent_if=("DBClusterNotFoundFault",))
    return response["DBClusters"][0] if response else None


def instance_status(instance_id):
    response = aws("rds", "describe-db-instances", "--db-instance-identifier", instance_id, absent_if=("DBInstanceNotFound",))
    return response["DBInstances"][0]["DBInstanceStatus"] if response else None


def describe_secret():
    """The login secret's ARN, or None when it doesn't exist."""
    response = aws("secretsmanager", "describe-secret", "--secret-id", NAMES["login_secret"],
                   absent_if=("ResourceNotFoundException",))
    return response["ARN"] if response else None


_secret_arn = None


def secret_arn():
    global _secret_arn
    if _secret_arn is None:
        _secret_arn = describe_secret() or stop(f"login secret {NAMES['login_secret']} is missing. terraform apply creates it, in Module 1")
    return _secret_arn


def sql_args(cluster_arn, statement, parameters=()):
    """The AWS CLI arguments for one parameterized SQL statement through the RDS Data API."""
    return ["rds-data", "execute-statement", "--resource-arn", cluster_arn, "--secret-arn", secret_arn(),
            "--database", NAMES["database"], "--sql", statement,
            "--parameters", json.dumps(list(parameters)), "--format-records-as", "JSON"]


def sql(cluster_arn, statement, parameters=(), absent_if=()):
    """One parameterized SQL statement through the RDS Data API. Returns rows as dicts."""
    response = aws(*sql_args(cluster_arn, statement, parameters), absent_if=absent_if)
    if response is None:
        return None
    return json.loads(response.get("formattedRecords") or "[]")


def insert_parameters(order):
    """One order as RDS Data API parameters: a None note goes in as SQL NULL, not as text. Pure."""
    return [
        {"name": "id", "value": {"longValue": int(order["id"])}},
        {"name": "customer", "value": {"stringValue": order["customer"]}},
        {"name": "total", "value": {"stringValue": str(order["total"])}, "typeHint": "DECIMAL"},
        {"name": "status", "value": {"stringValue": order["status"]}},
        {"name": "note", "value": {"isNull": True} if order["note"] is None else {"stringValue": order["note"]}},
        {"name": "placed_at", "value": {"stringValue": order["placed_at"]}, "typeHint": "TIMESTAMP"},
        {"name": "document_key", "value": {"stringValue": order["document_key"]}},
        {"name": "document_sha256", "value": {"stringValue": order["document_sha256"]}},
    ]


# IGNORE keeps rows that already exist, so a batch that's sent again never writes a row twice.
INSERT_ORDER_SQL = ("INSERT IGNORE INTO orders (id, customer, total, status, note, placed_at, document_key, document_sha256) "
                    "VALUES (:id, :customer, :total, :status, :note, :placed_at, :document_key, :document_sha256)")


def insert_orders(cluster_arn, orders):
    """Inserts orders with parameters, in batches. Rows that already exist stay as they are."""
    for start in range(0, len(orders), ROWS_PER_INSERT):
        parameter_sets = [insert_parameters(o) for o in orders[start:start + ROWS_PER_INSERT]]
        aws("rds-data", "batch-execute-statement", "--resource-arn", cluster_arn, "--secret-arn", secret_arn(),
            "--database", NAMES["database"], "--sql", INSERT_ORDER_SQL, "--parameter-sets", json.dumps(parameter_sets))


def query_readiness(cluster_id):
    """(the cluster's ARN, None) if it answers SQL right now, else (None, why not). Read-only."""
    cluster = describe_cluster(cluster_id)
    if cluster is None:
        return None, "the cluster doesn't exist"
    if not cluster.get("HttpEndpointEnabled"):
        return None, "its RDS Data API is off"
    if not cluster["DBClusterMembers"]:
        return None, "it has no instance"
    response, message = aws_answer(*sql_args(cluster["DBClusterArn"], "SELECT 1"), absent_if=NOT_QUERYABLE)
    return (cluster["DBClusterArn"], None) if response is not None else (None, message)


def queryable_arn(cluster_id):
    """The cluster's ARN if it answers SQL right now, else None. Read-only."""
    return query_readiness(cluster_id)[0]


def prepare(cluster_id):
    """Makes a cluster queryable: adds an instance and turns on the Data API if needed, then waits."""
    cluster = describe_cluster(cluster_id)
    if cluster is None:
        stop(f"cluster {cluster_id} not found. Check the name, and that the restore has finished")
    if not cluster["DBClusterMembers"]:
        # The main cluster gets the instance name Terraform uses, so ./lab down knows to keep it.
        instance = NAMES["instance"] if cluster_id == NAMES["cluster"] else f"{cluster_id}-1"
        say(f"adding instance {instance} (restores can arrive without one)")
        aws("rds", "create-db-instance", "--db-instance-identifier", instance,
            "--db-cluster-identifier", cluster_id, "--engine", "aurora-mysql", "--db-instance-class", "db.r6g.large",  # as app/main.tf
            "--tags", json.dumps([{"Key": k, "Value": v} for k, v in workshop_tags().items()]))
    if not cluster.get("HttpEndpointEnabled"):
        say(f"turning on the RDS Data API for {cluster_id} (restores can arrive without it)")
        aws("rds", "enable-http-endpoint", "--resource-arn", cluster["DBClusterArn"])
    say(f"waiting until {cluster_id} answers SQL")
    for _ in range(WAIT_ROUNDS):
        arn, why_not = query_readiness(cluster_id)
        if arn:
            return arn
        time.sleep(WAIT_SECONDS)
    stop(f"{cluster_id} doesn't answer SQL after {WAIT_LIMIT}. AWS's last answer: {why_not}. "
         "Check it is Available, then run this again")


def delete_cluster(cluster_id, keep_instance=None):
    """Deletes a cluster's instances except keep_instance, then the cluster when nothing is kept.
    Safe to run again after an interruption: what is already being deleted is only waited for."""
    cluster = describe_cluster(cluster_id)
    if cluster is None:
        return
    members = [m["DBInstanceIdentifier"] for m in cluster["DBClusterMembers"] if m["DBInstanceIdentifier"] != keep_instance]
    for instance in members:
        if instance_status(instance) not in (None, "deleting"):
            say(f"deleting instance {instance}")
            aws("rds", "delete-db-instance", "--db-instance-identifier", instance)
    for instance in members:
        run("aws", "rds", "wait", "db-instance-deleted", "--db-instance-identifier", instance, "--region", REGION)
    if keep_instance:
        return
    if cluster["Status"] != "deleting":
        say(f"deleting cluster {cluster_id} and its automated backups")
        aws("rds", "delete-db-cluster", "--db-cluster-identifier", cluster_id, "--skip-final-snapshot",
            "--delete-automated-backups")
    for _ in range(WAIT_ROUNDS):
        if describe_cluster(cluster_id) is None:
            return
        time.sleep(WAIT_SECONDS)
    stop(f"{cluster_id} is still being deleted after {WAIT_LIMIT}. Run this again later")


def restored_clusters():
