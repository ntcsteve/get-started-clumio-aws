# Information for Module 4, where it's compared with the archive's own SQL. Not part of the verdict.
TOTALS_SQL = "SELECT COUNT(*) AS orders, SUM(total) AS total, SUM(note IS NULL) AS null_notes FROM orders"


def describe_totals(totals):
    """The totals line ./lab check prints."""
    return f"{totals['orders']} orders, {totals['total'] or 0} in total, {totals['null_notes'] or 0} notes NULL"


# The schema check. A record restore brings rows only, into the existing table: this proves the
# table is still what it should be. A full restore brings the definition too: this proves it came back.

def read_schema(cluster_arn):
    """The tables' columns (name, type, NULL or NOT NULL) and indexes (name, column, unique or not),
    as information_schema lists them."""
    columns = sql(cluster_arn, "SELECT TABLE_NAME AS t, COLUMN_NAME AS c, COLUMN_TYPE AS type, IS_NULLABLE AS nullable "
                               "FROM information_schema.columns WHERE table_schema = DATABASE() ORDER BY t, c")
    indexes = sql(cluster_arn, "SELECT TABLE_NAME AS t, INDEX_NAME AS i, COLUMN_NAME AS c, NON_UNIQUE AS non_unique "
                               "FROM information_schema.statistics WHERE table_schema = DATABASE() ORDER BY t, i, c")
    return {"columns": [[r["t"], r["c"], r["type"], r["nullable"]] for r in columns],
            "indexes": [[r["t"], r["i"], r["c"], int(r["non_unique"])] for r in indexes]}


def schema_difference(saved, current):
    """What differs between the schema ./lab seed saved and the one there now: [] when they match. Pure."""
    differences = []
    for part, label in (("columns", "column"), ("indexes", "index")):
        saved_set, current_set = {tuple(x) for x in saved[part]}, {tuple(x) for x in current[part]}
        differences += [f"{label} {' '.join(map(str, x))} missing" for x in sorted(saved_set - current_set)]
        differences += [f"{label} {' '.join(map(str, x))} added" for x in sorted(current_set - saved_set)]
    return differences


def schema_finding(cluster_arn):
    """Compares the schema now with the copy ./lab seed saved: "matches", "different: <the first
    three differences>", or "not checked" before a seed."""
    if not os.path.exists(SCHEMA_FILE):
        return "not checked: ./lab seed saves it"
    with open(SCHEMA_FILE) as file:
        difference = schema_difference(json.load(file), read_schema(cluster_arn))
    return "matches" if not difference else "different: " + ", ".join(difference[:3])


def read_database(findings):
    """Reads the live database: adds its schema and totals to findings, and returns its rows by id.
    Returns None, with the reason in findings, when it can't be read."""
    cluster = describe_cluster(NAMES["cluster"])
    if cluster is None:
        findings["database"] = "missing"
        return None
    if not cluster.get("HttpEndpointEnabled") or not cluster["DBClusterMembers"]:  # what ./lab prepare fixes
        findings["database"] = f"not queryable: run ./lab prepare {NAMES['cluster']}"
        return None
    if describe_secret() is None:
        findings["login secret"] = "missing"
        return None
    arn = cluster["DBClusterArn"]  # no probe: the reads below wait through a passing "starting" answer
    # No status gate either: "backing-up" (Clumio backing it up) still serves queries. The first read names
    # an answer that won't pass on its own, instead of stopping on it.
    response, why_not = aws_answer(*sql_args(arn, "SELECT 1 AS found FROM information_schema.tables "
                                                  "WHERE table_schema = DATABASE() AND table_name = 'orders'"),
                                   absent_if=NOT_SERVING)
    if response is None:
        findings["database"] = f"not queryable: {why_not}"
        return None
    if not json.loads(response.get("formattedRecords") or "[]"):
        findings["orders table"] = "missing: run ./lab seed"
        return None
    findings["schema"] = schema_finding(arn)
    findings["totals"] = sql(arn, TOTALS_SQL)[0]
    return {int(r["id"]): r for r in sql(arn, f"SELECT {', '.join(ORDER_COLUMNS)} FROM orders")}


def read_document_hashes(findings):
    """Each document's sha256 by order id, or None, with the reason added to findings."""
    if not bucket_exists():
        findings["documents bucket"] = "missing"
        return None
    hashes = {}
    with tempfile.TemporaryDirectory() as folder:
        run("aws", "s3", "sync", f"s3://{documents_bucket()}/{NAMES['documents_prefix']}", folder,
            "--only-show-errors", "--region", REGION)
        for name in os.listdir(folder):
            match = re.fullmatch(r"order-(\d+)\.json", name)
            if match:
                hashes[int(match.group(1))] = sha256(open(os.path.join(folder, name)).read())
    return hashes


def database_time(value):
    """A DATETIME as the RDS Data API or a CSV may write it, with or without the T and milliseconds;
    None if it isn't one. Pure."""
    match = re.fullmatch(r"(\d{4}-\d\d-\d\d)[ T](\d\d:\d\d:\d\d)(?:\.(\d{1,6}))?", str(value))
    if not match:
        return None
    return datetime.datetime.strptime(f"{match[1]} {match[2]}.{(match[3] or '').ljust(6, '0')}", "%Y-%m-%d %H:%M:%S.%f")


def is_same_value(column, value, seeded):
    """Whether a value read back equals the one ./lab seed loaded, in whatever form it's written:
    370.5 and "370.50" are the same total. Text must match exactly. Pure."""
    if value is None or seeded is None:
        return value is None and seeded is None
    if column == "total":
        try:
            return decimal.Decimal(str(value)) == decimal.Decimal(seeded)
        except decimal.InvalidOperation:
            return False
    if column == "placed_at":
        return database_time(value) is not None and database_time(value) == database_time(seeded)
    return value == seeded


def compare_rows(rows):
    """Each row against what ./lab seed loaded: 0, or the count of changed orders with the columns that
    changed. A NULL that became empty text, as a plain LOAD DATA does to Clumio's CSV, is a change like
    any other: HEALTHY means exact. Pure."""
    changed_columns, changed_orders = collections.Counter(), 0
    for order_id, row in rows.items():
        seeded = order_for(order_id)
        differing = [c for c in ORDER_COLUMNS[1:] if not is_same_value(c, row.get(c), seeded[c])]  # [0] is the id
        if differing:
            changed_orders += 1
            changed_columns.update(differing)
    if not changed_orders:
        return 0
    columns = sorted(changed_columns.items(), key=lambda item: (-item[1], ORDER_COLUMNS.index(item[0])))
    return f"{changed_orders} ({', '.join(f'{c}: {n}' for c, n in columns)})"


def judge(orders, documents, findings):
    """The check's verdict: adds the counts to findings, and is HEALTHY only when every order exists
    unchanged, with its intact document, the control order included. Pure, so the tests cover it.
    orders: the rows read, by order id, or None. documents: each document's sha256 by order id, or None."""
    if orders is not None:
        findings["orders missing"] = sum(1 for i in ORDER_IDS if i not in orders)
        findings["orders changed"] = compare_rows(orders)
    if documents is not None:
        findings["documents missing"] = sum(1 for i in ORDER_IDS if i not in documents)
        findings["documents changed"] = sum(1 for i in ORDER_IDS if i in documents and documents[i] != sha256(document_for(i)))
    control_ok = (CONTROL_ORDER in (orders or ())
                  and (documents or {}).get(CONTROL_ORDER) == sha256(document_for(CONTROL_ORDER)))
    findings[f"control order {CONTROL_ORDER}"] = "intact" if control_ok else "BROKEN"
    return all(is_fine(name, value) for name, value in findings.items())


def is_fine(name, value):
    """Whether one finding is fine: nothing missing or changed, or information only. The verdict and
    the scorecard both use this, so they can't disagree."""
    return name == "totals" or value in (0, "intact", "matches") or str(value).startswith("not checked")


# --- The portal: one order at a time, in a browser on this computer ------------------------------
#
# Read-only. Every request reads the database and the document again, so the page shows the real
# state during each incident. It runs on this computer with your AWS sign-in: no Lambda, no public
# URL, nothing to deploy. Every failure is a named state on the page, never a crash: the page must
# stay up while the data is gone.

PORTAL_CALL_SECONDS = 20  # one AWS call at most; the CLI's own timeouts below come first
SIGN_IN_EXPIRED = "your AWS sign-in expired: run aws sso login, then check again"
DOCUMENT_MISSING = ("NoSuchKey", "NoSuchBucket")


def judge_portal_order(order, document):
    """The page's state and reason for one order. Pure. Each answer is (kind, value), with kind
    found, missing, unavailable (the database only) or cant_check, whose value is the reason."""
    kind, value = order
    if kind == "cant_check":
        return "CAN'T CHECK", value
    if kind == "unavailable":
        return "BROKEN", "database unavailable"
    if kind == "missing":
        return "BROKEN", "order missing from the database"
    document_kind, text = document
    if document_kind == "cant_check":
        return "CAN'T CHECK", text
    if document_kind == "missing":
        return "BROKEN", "delivery document missing"
    if sha256(text) != value["document_sha256"]:
        return "BROKEN", "delivery document changed"
    return "HEALTHY", "order and document match"


def portal_failure(stderr):
    """Why the portal can't check, in words the reader can act on. Pure."""
    if "expired" in stderr.lower():
        return SIGN_IN_EXPIRED
    if "timeout" in stderr.lower() or "timed out" in stderr.lower():
        return "AWS didn't answer in time"
    code = re.search(r"An error occurred \(([^)]+)\)", stderr)
    return f"AWS answered {code.group(1)}" if code else f"AWS failed: {stderr.strip()[:120]}"


def parse_order_id(raw):
    """An order number from the page, or None. The only input the portal takes. Pure."""
    return int(raw) if re.fullmatch(r"[0-9]{1,4}", raw or "") and int(raw) in ORDER_IDS else None


def is_local_host(host, port):
    """Whether a request names this computer. Another name pointing at 127.0.0.1 (DNS rebinding)
    could let a web page read the portal; the Host header tells them apart. Pure."""
    return host in (f"localhost:{port}", f"127.0.0.1:{port}")


def portal_call(*args):
    """One AWS CLI call that never stops the portal: (answer, error code, reason)."""
    command = ["aws", *args, "--region", REGION, "--output", "json", "--cli-connect-timeout", "3", "--cli-read-timeout", "10"]
    try:
        result = subprocess.run(command, capture_output=True, text=True, cwd=HERE, timeout=PORTAL_CALL_SECONDS)
    except subprocess.TimeoutExpired:
        return None, None, "AWS didn't answer in time"
    if result.returncode == 0:
        return json.loads(result.stdout or "{}"), None, None
    code = re.search(r"An error occurred \(([^)]+)\)", result.stderr)
    return None, code.group(1) if code else None, portal_failure(result.stderr)


def find_portal_order(cluster_arn, order_id):
    answer, code, reason = portal_call(
        "rds-data", "execute-statement", "--resource-arn", cluster_arn, "--secret-arn", secret_arn(),
        "--database", NAMES["database"], "--format-records-as", "JSON",
        "--sql", "SELECT id, customer, total, status, document_sha256 FROM orders WHERE id = :id",
        "--parameters", json.dumps([{"name": "id", "value": {"longValue": order_id}}]))
    if answer is None:
        # Deleted, restoring, or without an instance or the Data API: what the incidents do to it.
        return ("unavailable", None) if code in NOT_QUERYABLE else ("cant_check", reason)
    rows = json.loads(answer.get("formattedRecords") or "[]")
    return ("found", rows[0]) if rows else ("missing", None)


def read_portal_document(order_id):
    with tempfile.TemporaryDirectory() as folder:
        body = os.path.join(folder, "document")
        answer, code, reason = portal_call("s3api", "get-object", "--bucket", documents_bucket(),
                                           "--key", document_key(order_id), body)
        if answer is None:
            return ("missing", None) if code in DOCUMENT_MISSING else ("cant_check", reason)
        with open(body, encoding="utf-8") as file:
            return "found", file.read()


def check_portal_order(cluster_arn, order_id):
    order = find_portal_order(cluster_arn, order_id)
    document = read_portal_document(order_id) if order[0] == "found" else None
    state, reason = judge_portal_order(order, document)
    details = order[1] if order[0] == "found" else {"id": order_id}
    return {**details, "state": state, "reason": reason}


def open_portal_server(port):
    """The portal's web server, on this computer only. A port in use stops with what to do."""
    import http.server

    # The cluster's ARN is its name: a restore under the same name answers at the same ARN.
    cluster_arn = f"arn:aws:rds:{REGION}:{ACCOUNT}:cluster:{NAMES['cluster']}"

    class Portal(http.server.BaseHTTPRequestHandler):
        timeout = 30  # seconds a connection may sit idle, such as a browser's preconnect, before it's closed

        def do_GET(self):
            # The error boundary: a bug shows on the page as CAN'T CHECK with its reason, and in this
            # terminal in full, never as a dropped connection the page would read as a stopped portal.
            try:
                self.answer()
            except (BrokenPipeError, ConnectionResetError):
                pass  # the browser closed the tab or moved on: nothing to answer, nothing wrong
            except Exception as error:
                traceback.print_exc()
                self.respond(500, {"state": "CAN'T CHECK", "reason": f"the portal hit an error ({type(error).__name__}): see its terminal"})

        def answer(self):
            if not is_local_host(self.headers.get("Host"), port):
                return self.respond(403, {"error": f"open http://localhost:{port}"})
            path, _, query = self.path.partition("?")
            if path == "/":
                return self.respond(200, PORTAL_PAGE, "text/html; charset=utf-8")
            order_id = parse_order_id(urllib.parse.parse_qs(query).get("order", [""])[0])
            if path not in ("/api/order", "/document"):
                return self.respond(404, {"error": "not found"})
            if order_id is None:
                return self.respond(400, {"error": "order must be a number from 1 to 1000"})
            if path == "/document":
                kind, text = read_portal_document(order_id)
                return self.respond(200, text, "application/json") if kind == "found" else self.respond(404, {"error": "document unavailable"})
            result = check_portal_order(cluster_arn, order_id)
            say(f"order {order_id}: {result['state']}, {result['reason']}")  # the terminal shows what the page shows
            return self.respond(200, result)

        def respond(self, status, body, content_type="application/json"):
            data = (body if isinstance(body, str) else json.dumps(body, default=str)).encode()
            self.send_response(status)
            self.send_header("Content-Type", content_type)
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def log_message(self, *_args):
            pass  # one line per check (above) instead of one per request

    try:
        # A thread per connection, so a browser's idle preconnect can't hold up the page. Bounded in
        # practice: only this computer can connect, and every connection times out (above).
        server = http.server.ThreadingHTTPServer(("127.0.0.1", port), Portal)
        server.daemon_threads = True  # Ctrl-C doesn't wait for an idle connection
        return server
    except OSError:
        stop(f"port {port} is in use. Stop what uses it, or run ./lab portal --port {port + 1}")


