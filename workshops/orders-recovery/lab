def cmd_break(args):
    if args.incident == "deploy":
        break_deploy()
    else:
        break_everything(args.confirm_account)


def break_deploy():
    """A bad deployment: deletes every tenth order, and overwrites 50 documents."""
    move, started_at = gate_incident("break deploy")
    arn = queryable_arn(NAMES["cluster"]) or stop("the database isn't queryable. Run ./lab check first")
    open_incident("break deploy", move, started_at)
    sql(arn, f"DELETE FROM orders WHERE id IN ({', '.join(str(i) for i in DELETED_BY_DEPLOY)})")  # ids are ints we made
    upload_documents({i: document_for(i).replace("delivery note", "delivery note (overwritten by deploy)")
                      for i in OVERWRITTEN_BY_DEPLOY})
    say(f"Bad deployment at {now():%Y-%m-%d %H:%M:%S} UTC: {len(DELETED_BY_DEPLOY)} orders deleted, "
        f"{len(OVERWRITTEN_BY_DEPLOY)} documents overwritten. Next: ./lab check")


def break_everything(confirmed=None):
    """The widest blast radius: the database with its automated backups, the bucket with every version."""
    move, started_at = gate_incident("break everything")
    confirm_by_account_id([f"database {NAMES['cluster']} and its automated backups", f"bucket {documents_bucket()} and every version"],
                          confirmed)
    open_incident("break everything", move, started_at)
    delete_cluster(NAMES["cluster"])
    empty_and_delete_bucket()
    say("Everything is gone from the account. Next: ./lab check, then recover with Clumio (docs/5-survive.md)")


def cmd_repair(args):
    """Copies only the missing orders back into the live database, from a restored cluster (4B) or
    from Clumio's record-restore CSV (4A). Orders that are there stay as they are."""
    if args.source == NAMES["cluster"]:
        stop("--from must be the restored cluster, not the live one")
    live = queryable_arn(NAMES["cluster"]) or stop(f"{NAMES['cluster']} isn't queryable. Run ./lab check")
    present = {int(r["id"]) for r in sql(live, "SELECT id FROM orders")}
    missing = [i for i in ORDER_IDS if i not in present]
    if not missing:
        say("No orders are missing. Nothing to copy")
        return
    if args.csv:
        source_name = os.path.basename(args.csv)
        rows = [order for order in read_orders_csv(args.csv) if int(order["id"]) in missing]
    else:
        source_name = args.source
        source = queryable_arn(args.source) or stop(f"{args.source} isn't queryable yet. Run ./lab prepare {args.source}")
        rows = sql(source, f"SELECT * FROM orders WHERE id IN ({', '.join(str(i) for i in missing)})")  # ids are ints we made
    insert_orders(live, rows)
    record("repair", source=source_name, copied=len(rows))
    say(f"Copied {len(rows)} of {len(missing)} missing orders from {source_name}. Next: ./lab check")


def cmd_prepare(args):
    prepare(args.cluster)
    say(f"{args.cluster} answers SQL")


def cmd_drop(args):
    # No account ID asked, unlike break everything and down: a dropped copy can be restored again from
    # Clumio's recovery point. Only a cluster restored_clusters() recognizes can be dropped (named
    # orders-db-... or in the workshop's subnet group), never the live database.
    if args.cluster == NAMES["cluster"]:
        stop("that's the live database. ./lab drop only deletes restored clusters")
    if args.cluster not in restored_clusters():
        stop(f"{args.cluster} isn't a workshop restore (named {NAMES['cluster']}-... or in subnet group "
             f"{NAMES['subnet_group']}). ./lab drop deletes nothing else")
    delete_cluster(args.cluster)
    say(f"{args.cluster} deleted")


def cmd_rebuild(_args):
    """Recreates the empty documents bucket, configured as Terraform built it, for Clumio's S3 restore.
    Terraform isn't run here: after a restore it could replace the restored database."""
    if bucket_exists():
        stop(f"{documents_bucket()} already exists. Nothing to rebuild")
    location = [] if REGION == "us-east-1" else ["--create-bucket-configuration", f"LocationConstraint={REGION}"]
    aws("s3api", "create-bucket", "--bucket", documents_bucket(), *location)
    aws("s3api", "put-bucket-versioning", "--bucket", documents_bucket(), "--versioning-configuration", "Status=Enabled")
    aws("s3api", "put-public-access-block", "--bucket", documents_bucket(), "--public-access-block-configuration",
        "BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true")
    tags = {**workshop_tags(), NAMES["protection_tag"]["key"]: NAMES["protection_tag"]["value"]}
    aws("s3api", "put-bucket-tagging", "--bucket", documents_bucket(), "--tagging",
        json.dumps({"TagSet": [{"Key": k, "Value": v} for k, v in tags.items()]}))
    record("rebuild")
    say(f"{documents_bucket()} recreated, empty and tagged for Clumio. Next: wait until Clumio lists it, then restore into it")


def cmd_report(_args):
    """The scorecard, and .lab/report.html, from the evidence log. Reads nothing from AWS or Clumio."""
    events = read_events()
    scorecard = incident_scorecard(events)
    print(f"  {'incident':20} {'back to HEALTHY after':23} damage found")
    for incident, damage, took in scorecard or [("none yet", "", "")]:
