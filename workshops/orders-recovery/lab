def parse_time(text):
    """An RFC 3339 time from Clumio or the evidence log, as an aware datetime (Python 3.9 safe)."""
    return datetime.datetime.fromisoformat(re.sub(r"\.\d+", "", text).replace("Z", "+00:00"))


def database_in_clumio():
    """orders-db as Clumio lists it, or None if Clumio hasn't found it yet."""
    resources = clumio_items("/datasources/aws/rds-resources?limit=100&filter=" + clumio_filter(
        {"account_native_id": {"$eq": ACCOUNT}, "name": {"$contains": NAMES["cluster"]}}))
    return next((r for r in resources if r.get("name") == NAMES["cluster"] and not r.get("is_deleted")), None)


def our_rds_policy_id():
    """The ID of the workshop's own RDS policy, or None before Terraform creates it."""
    name = f"{NAMES['clumio_rds_policy_prefix']}{ACCOUNT}"
    policies = clumio_items("/policies/definitions?filter=" + clumio_filter({"name": {"$eq": name}}))
    return policies[0]["id"] if policies else None


def protection_owner(database, our_policy_id):
    """Who protects orders-db: ("ours", None), ("none", None), or ("another", the rule that matched
    it). Clumio applies the first rule that matches, so an older, wider rule can win. Pure."""
    info = database.get("protection_info") or {}
    if not info.get("policy_id"):
        return "none", None
    if info["policy_id"] == our_policy_id:
        return "ours", None
    return "another", info.get("rule_id")


def protection_reason(owner):
    """Why the incidents can't start yet, for an owner that isn't ours; None when it is. Pure."""
    who, rule_id = owner
    if who == "ours":
        return None
    if who == "none":
        return f"Clumio hasn't applied a policy to {NAMES['cluster']} yet: wait, then run ./lab status again"
    return (f"{NAMES['cluster']} is protected by another Clumio policy, through rule {rule_id}: an older rule matched it "
            f'first. Set rds_rule_before_id = "{rule_id}" in terraform.tfvars, then run terraform apply. Or ask your '
            "Clumio administrator to narrow that rule")


def latest_database_recovery_points(database):
    """orders-db's latest recovery point start time in each SecureVault tier, or None if Clumio
    hasn't found the database yet."""
    if database is None:
        return None
    tiers = {"aws_rds_resource_rolling_backup": "SecureVault Standard", "aws_rds_resource_granular_backup": "SecureVault Archive"}
    latest = {}
    for backup in clumio_items("/backups/aws/rds-resources?limit=100&filter=" + clumio_filter(
            {"resource_id": {"$eq": database["id"]}})):
        tier = tiers.get(backup.get("type"))
        if tier and backup.get("start_timestamp", "") > latest.get(tier, ""):
            latest[tier] = backup["start_timestamp"]
    return latest


def latest_documents_recovery_point():
    """The start time of the documents' latest SecureVault backup: "" if none yet, None if Clumio
    hasn't made the protection group yet."""
    groups = clumio_items("/datasources/protection-groups?filter=" + clumio_filter(
        {"name": {"$eq": f"{NAMES['clumio_s3_policy_prefix']}{ACCOUNT}"}, "is_deleted": {"$eq": False}}))
    if not groups:
        return None
    backups = clumio_items("/backups/protection-groups?limit=100&filter=" + clumio_filter(
        {"protection_group_id": {"$eq": groups[0]["id"]}}))
    return max((b.get("start_timestamp", "") for b in backups), default="")


def readiness(seeded_at, database_points, documents_point, needs_archive=False):
    """Whether Clumio holds recovery points of the loaded data: (is_ready, reason). Pure, so the
    tests cover it. An incident before this is true could destroy the only copy. With the archive
    on, it needs an archive point too: the archive runs monthly, so a late first one holds the damage."""
    if database_points is None or not database_points.get("SecureVault Standard"):
        return False, "no SecureVault recovery point of the database yet"
    if not documents_point:
        return False, "no SecureVault recovery point of the documents yet"
    if needs_archive and not database_points.get("SecureVault Archive"):
        return False, "no SecureVault Archive recovery point of the database yet"
    if seeded_at:
        points = [("the database's", database_points["SecureVault Standard"]), ("the documents'", documents_point)]
        if needs_archive:
            points.append(("the archive's", database_points["SecureVault Archive"]))
        for whose, taken_at in points:
            if parse_time(taken_at) < parse_time(seeded_at):
                return False, f"{whose} latest recovery point is from before the data was loaded"
    return True, "Clumio holds recovery points of the loaded data"


def read_events():
    """The evidence log, oldest first. ./lab record() writes it."""
    path = os.path.join(EVIDENCE_DIR, "events.jsonl")
    if not os.path.exists(path):
        return []
    with open(path) as log:
        return [json.loads(line) for line in log]


def since_last_down(events):
    """The events of this deployment: everything after the last ./lab down."""
    return events[max((i for i, e in enumerate(events) if e["event"] == "down"), default=-1) + 1:]


def last_seed_time():
    """When ./lab seed last ran in this deployment, from the evidence log, or None."""
    return next((e["at"] for e in reversed(read_events()) if e["event"] == "seed"), None)


def incident_since_deploy():
    """The incident in the evidence log since the last ./lab down, if any."""
    return next((e["event"] for e in since_last_down(read_events()) if e["event"] in INCIDENTS), None)


def incident_spans(events):
    """The evidence log as incidents: the one definition ./lab break and the scorecard share. Pure.
    An incident opens at its break, gathers the checks after it, and ends at a HEALTHY check
    ("healthy"), at ./lab down ("down"), or at the next incident ("next incident", which only an
    older lab could log: the gates block it). "ended" is None while it's open."""
    spans, current = [], None
    for event in events:
        if event["event"] in INCIDENTS:
            if current:
                current["ended"] = "next incident"
            current = {"start": event, "checks": [], "ended": None}
            spans.append(current)
        elif current and event["event"] == "check":
            current["checks"].append(event)
            if event.get("state") == "HEALTHY":
                current["ended"], current = "healthy", None
        elif current and event["event"] == "down":
            current["ended"], current = "down", None
    return spans


def incident_start(events, incident):
    """What ./lab break does with the evidence log. Pure. Returns ("record", None) when no incident is
    open, ("continue", its start time) when this one is open (a rerun after a stop), or ("blocked",
    the open one)."""
    spans = incident_spans(events)
    if not spans or spans[-1]["ended"]:
        return "record", None
    start = spans[-1]["start"]
    if start["event"] == incident:
        return "continue", start["at"]
    return "blocked", start["event"]


def gate_incident(incident):
    """The first step of every ./lab break. A different open incident stops here, before anything is
    read, asked or changed. A new incident must pass the readiness gate. A rerun of the open one
    skips it: readiness held when it started, and its own damage may now hide it. Returns the move
    for open_incident()."""
    move, detail = incident_start(read_events(), incident)
    if move == "blocked":
        stop(f"./lab {detail} is still open. Recover first, until ./lab check says HEALTHY. Nothing was changed")
    if move == "record":
        require_recovery_points()
    return move, detail  # for "continue", detail is when the open incident started


def open_incident(incident, move, started_at):
    """The last step before the damage: records a new incident, so the scorecard has one start time
    for it, even if the damage is interrupted and run again."""
    if move == "continue":
        say(f"continuing ./lab {incident}, which started {started_at}")
    else:
        record(incident)


def require_recovery_points():
    """Stops an incident while Clumio has no copy of the loaded data to recover from, or while the
    copies would come from another policy than the workshop's."""
    database = database_in_clumio()
    if database:
        reason = protection_reason(protection_owner(database, our_rds_policy_id()))
        if reason:
            stop(f"{reason}. Nothing was changed")
    is_ready, reason = readiness(last_seed_time(), latest_database_recovery_points(database), latest_documents_recovery_point(),
                                 is_archive_on())
    if not is_ready:
        stop(f"{reason}. Nothing was changed: run ./lab status, and wait until it says ready")


