    with open(report, "w") as file:
        file.write(report_html(events, ACCOUNT, REGION))
    say(f"Report: {report}")


def report_html(events, account, region):
    """The report as a web page, made to be shared: the account shows only its last four digits, and
    every value from the log is escaped. Pure."""
    masked = "XXXXXXXX" + account[-4:]

    def shareable(value):  # AWS's own error text can name an ARN, and every ARN holds the account ID
        return html.escape(str(value).replace(account, masked))

    def readable(at):
        return f"{parse_time(at):%Y-%m-%d %H:%M}"  # the column header says UTC

    def cells(event):
        details = {**event.get("findings", {}), **{k: v for k, v in event.items() if k in ("source", "copied")}}
        if isinstance(details.get("totals"), dict):
            details["totals"] = describe_totals(details["totals"])
        values = [readable(event["at"]), event["event"], event.get("state", ""), ", ".join(f"{k}: {v}" for k, v in details.items())]
        return "".join(f"<td>{shareable(value)}</td>" for value in values)  # the log is text, the report a web page
    rows = "".join(f"<tr>{cells(e)}</tr>" for e in events)
    score_rows = "".join("<tr>" + "".join(f"<td>{shareable(v)}</td>" for v in row) + "</tr>"
                         for row in incident_scorecard(events))
    return f"""<!doctype html><meta charset="utf-8"><title>Orders recovery report</title>
<style>body{{font-family:system-ui,sans-serif;max-width:60rem;margin:2rem auto;padding:0 1rem}}td,th{{padding:.4rem .8rem;border-bottom:1px solid #ddd;text-align:left}}</style>
<h1>Orders recovery report</h1>
<p>Account ending {account[-4:]}, Region {region}. Clumio's own record of each recovery: Clumio console, Activity, Tasks.</p>
<h2>Scorecard</h2>
<p>From each incident to the first ./lab check that said HEALTHY again.</p>
<table><tr><th>Incident</th><th>Damage found</th><th>Back to HEALTHY after</th></tr>{score_rows}</table>
<h2>Every recorded event</h2>
<table><tr><th>Time (UTC)</th><th>Event</th><th>Result</th><th>Details</th></tr>{rows}</table>"""


def cmd_down(args):
    """Asks once, then deletes what Terraform doesn't know (restores, added instances), then the rest."""
    restored = restored_clusters()
    main = describe_cluster(NAMES["cluster"])
    added = [m["DBInstanceIdentifier"] for m in (main["DBClusterMembers"] if main else [])
             if m["DBInstanceIdentifier"] != NAMES["instance"]]
    confirm_by_account_id([f"restored cluster {c}" for c in restored]
                          + [f"instance {i} in {NAMES['cluster']}, added after Terraform built it" for i in added]
                          + ["everything Terraform built: the database, the documents bucket and every version, "
                             "the network, the login secret, and the Clumio connection and policies"],
                          args.confirm_account)
    for cluster in restored:
        delete_cluster(cluster)
    delete_cluster(NAMES["cluster"], keep_instance=NAMES["instance"])
    say("running terraform destroy")
    # Already confirmed above: a second yes/no here could stop halfway, after the deletes.
    if subprocess.run(["terraform", "destroy", "-auto-approve", "-input=false"], cwd=HERE).returncode != 0:
        stop("terraform destroy didn't finish. Fix the error above, then run ./lab down again")
    left = [f"cluster {c}" for c in restored_clusters()]
    if describe_cluster(NAMES["cluster"]):
        left.append(f"cluster {NAMES['cluster']}")
    if bucket_exists():
        left.append(f"bucket {documents_bucket()}")
    if describe_secret():
        left.append(f"secret {NAMES['login_secret']}")
    if is_clumio_connected():
        left.append("Clumio connection")
    for prefix in ("clumio_rds_policy_prefix", "clumio_s3_policy_prefix"):
        name = f"{NAMES[prefix]}{ACCOUNT}"
        if clumio_items("/policies/definitions?filter=" + clumio_filter({"name": {"$eq": name}})):
            left.append(f"Clumio policy {name}")
    if left:
        stop(f"still there: {', '.join(left)}. Run ./lab down again")
    record("down")  # a new deployment starts a new evidence log section
    say("DONE: the workshop is gone. Clumio keeps recovery points it already took until their retention ends")


# --- Output, failure and evidence ----------------------------------------------------------------

def now():
    return datetime.datetime.now(datetime.timezone.utc)


def say(message):
    print(f"[{now():%H:%M:%S} UTC] {message}", flush=True)  # UTC, like ./lab status and the report


def stop(message):
    print(f"STOP: {message}", file=sys.stderr)
    sys.exit(1)


def record(event, **details):
    """Appends one timestamped event to the evidence log that ./lab report reads."""
    os.makedirs(EVIDENCE_DIR, exist_ok=True)
    with open(os.path.join(EVIDENCE_DIR, "events.jsonl"), "a") as log:
        log.write(json.dumps({"at": now().isoformat(timespec="seconds"), "event": event, **details}) + "\n")


# --- Settings and names --------------------------------------------------------------------------

def read_tfvars():
    path = os.path.join(HERE, "terraform.tfvars")
    if not os.path.exists(path):
        stop("no terraform.tfvars. Run: cp terraform.tfvars.example terraform.tfvars, then set account_id and region")
    return open(path).read()


def read_setting(key):
    match = re.search(rf'^\s*{key}\s*=\s*"([^"]*)"', read_tfvars(), re.M)
    return match.group(1) if match else ""


def is_archive_on():
    """Whether terraform.tfvars keeps archive copies (archive_retention_months above 0)."""
    match = re.search(r"^\s*archive_retention_months\s*=\s*([0-9]+)", read_tfvars(), re.M)
    return bool(match and int(match.group(1)) > 0)


def load_settings():
    global ACCOUNT, REGION
    ACCOUNT, REGION = read_setting("account_id"), read_setting("region")
    if not re.fullmatch(r"\d{12}", ACCOUNT):
        stop("set account_id in terraform.tfvars to your 12-digit test account ID")
    if not re.fullmatch(r"[a-z]{2}-[a-z]+-\d", REGION):  # commercial Regions only
        stop("set region in terraform.tfvars, such as ap-southeast-1")


def workshop_tags():
    """The tags Terraform put on every resource (its tags output), for what ./lab creates itself."""
    return json.loads(run("terraform", "output", "-json", "tags").stdout)


def documents_bucket():
    return f"{NAMES['bucket_prefix']}{ACCOUNT}"


def document_key(order_id):
    return f"{NAMES['documents_prefix']}order-{order_id}.json"


# --- Safety: the account, and a pause before anything nobody can undo ----------------------------

def confirm_signed_in_account():
    """Every AWS command runs only in the account terraform.tfvars names. A terminal signed in to
    another account stops here, before it reads or changes anything."""
    identity = run("aws", "sts", "get-caller-identity", "--output", "json", expect_failure=True)
    if identity.returncode != 0:
        stop(f"not signed in to AWS ({identity.stderr.strip()[:200]}). Sign in (for example: aws sso login), then run this again")
    signed_in = json.loads(identity.stdout)["Account"]
    if signed_in != ACCOUNT:
        stop(f"signed in to AWS account {signed_in}, but terraform.tfvars says {ACCOUNT}. Nothing was changed")


def confirm_by_account_id(what_goes, confirmed=None):
    """The one pause before a deletion nobody can undo: lists what goes, then needs the account ID,
    typed by a person or passed by an agent as --confirm-account. Either must match terraform.tfvars."""
    print(f"This deletes, in account {ACCOUNT}:")
    for item in what_goes:
        print(f"  {item}")
    print("You can't undo it.")
    if confirmed is None:
        try:
            confirmed = input(f"Type the account ID ({ACCOUNT}) to continue: ").strip()
        except EOFError:  # no terminal, as in an agent's shell
            stop("no one typed the account ID. An agent passes it with --confirm-account, after the person's go. "
                 "Nothing was deleted")
    if confirmed != ACCOUNT:
        stop("the account ID didn't match. Nothing was deleted")


# --- External calls: loud by default. "Absent" is only ever AWS's own not-found answer -----------

def run(*command, expect_failure=False):
    try:
        result = subprocess.run(command, capture_output=True, text=True, cwd=HERE)
    except FileNotFoundError:
        stop(f"{command[0]} not found. Install it (see docs/0-setup.md)")
    if result.returncode != 0 and not expect_failure:
        stop(f"{' '.join(command[:3])} failed: {result.stderr.strip()[:500]}")
    return result


def aws_answer(*args, absent_if=()):
    """One AWS CLI call in the workshop's Region: (parsed JSON, None), or (None, AWS's message) when AWS
    answers with an error code in absent_if. The RDS Data API answers "starting" for a while after it's
    turned on, and now and then later (seen live): unless the caller asks for that answer in absent_if,
    it's waited through here, within WAIT_LIMIT. A call refused that way did nothing, so sending it
    again is safe. Any other failure (an expired sign-in, AccessDenied, throttling) stops."""
    for round_number in range(WAIT_ROUNDS):
        result = run("aws", *args, "--region", REGION, "--output", "json", expect_failure=True)
        if result.returncode == 0:
            return (json.loads(result.stdout) if result.stdout.strip() else {}), None
        message = result.stderr.strip().splitlines()[0][:300] if result.stderr.strip() else "no answer"
        code = re.search(r"An error occurred \(([^)]+)\)", result.stderr)
        code = code.group(1) if code else None
        if code in absent_if:
            return None, message
        if args[0] != "rds-data" or code not in DATA_API_STARTING:
            stop(f"aws {' '.join(args[:2])} failed: {result.stderr.strip()[:500]}")
        if round_number == 0:
            say(f"the RDS Data API is still starting ({code}); waiting up to {WAIT_LIMIT} for this call")
        time.sleep(WAIT_SECONDS)
    stop(f"the RDS Data API still isn't ready after {WAIT_LIMIT}. AWS's last answer: {message}. Run this again later")


def aws(*args, absent_if=()):
    """aws_answer without the message: parsed JSON, or None for an expected absence."""
    return aws_answer(*args, absent_if=absent_if)[0]


def get_clumio(path):
    """GET from the Clumio API. Returns (HTTP status, body). The token goes in a header, never a URL."""
    token, base = os.environ.get("CLUMIO_API_TOKEN"), os.environ.get("CLUMIO_API_BASE_URL")
    if not token or not base:
        stop("export CLUMIO_API_TOKEN and CLUMIO_API_BASE_URL first (see docs/0-setup.md)")
    request = urllib.request.Request(base.rstrip("/") + path,
                                     headers={"Authorization": f"Bearer {token}", "Accept": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=60) as response:
            return response.status, json.loads(response.read() or b"{}")
    except urllib.error.HTTPError as error:
        return error.code, {}
    except urllib.error.URLError as error:
        stop(f"can't reach Clumio at {base}: {error.reason}")


def clumio_items(path):
    """A Clumio list call that must succeed. Anything but HTTP 200 stops, so 'none' is never a guess."""
    status, body = get_clumio(path)
    if status != 200:
        stop(f"Clumio answered HTTP {status} for {path.split('?')[0]}. Check the token (it may have expired)")
    return body.get("_embedded", {}).get("items", [])


def clumio_filter(condition):
    return urllib.parse.quote(json.dumps(condition))


def is_clumio_connected():
    """Whether this account and Region are connected to Clumio. Only 200 or 404 is an answer."""
    status, _ = get_clumio(f"/connections/aws/{ACCOUNT}_{REGION}")
    if status not in (200, 404):
        stop(f"Clumio answered HTTP {status} for the connection. Check the token (it may have expired)")
    return status == 200


