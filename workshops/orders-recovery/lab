    print(f"  database in Clumio       {'found' if database_points is not None else 'not found yet'}")
    print(f"    protected by           " + {"ours": "the workshop's policy", "none": "no policy yet",
                                            "another": f"another policy, through rule {owner[1]}"}[owner[0]])
    for tier in ("SecureVault Standard", "SecureVault Archive"):
        print(f"    {tier:22} {(database_points or {}).get(tier) or 'none yet'}")
