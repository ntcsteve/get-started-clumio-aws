HERE = os.path.dirname(os.path.abspath(__file__))
EVIDENCE_DIR = os.path.join(HERE, ".lab")
with open(os.path.join(HERE, "names.json")) as names_file:
    NAMES = json.load(names_file)
ORDER_IDS = range(1, 1001)
CONTROL_ORDER = 1  # the bad deployment doesn't touch it, so a correct recovery leaves it as it was
DELETED_BY_DEPLOY = [i for i in ORDER_IDS if i % 10 == 0]               # 100 orders
OVERWRITTEN_BY_DEPLOY = [i for i in ORDER_IDS if i % 10 == 5 and i <= 500]  # 50 documents
WAIT_SECONDS, WAIT_ROUNDS = 20, 60  # poll every 20 seconds, 60 times at most
WAIT_LIMIT = f"{WAIT_SECONDS * WAIT_ROUNDS // 60} minutes"
ROWS_PER_INSERT = 200  # well under the RDS Data API's request size limit
CSV_SIZE_LIMIT_MB = 1  # a record restore of all 1,000 orders is about 0.2 MB
EARLIEST_TIME, LATEST_TIME = datetime.datetime(2000, 1, 1), datetime.datetime(2101, 1, 1)  # sample data is from 2026
ORDER_COLUMNS = ("id", "customer", "total", "status", "note", "placed_at", "document_key", "document_sha256")
SCHEMA_FILE = os.path.join(EVIDENCE_DIR, "schema.json")  # saved by ./lab seed, compared by ./lab check
INCIDENTS = {"break deploy": "Bad deployment", "break everything": "Everything deleted"}
ACCOUNT, REGION = None, None  # from terraform.tfvars, set by load_settings()


# How this file reads, top to bottom: the entry point, then one function per command in the order
# the workshop uses them, then the parts those commands are built from, in the order they first need them.
#   Entry point                   main(): the command line, and the function behind each command
#   Commands                      preflight, seed, check, portal, status, break, repair, prepare, drop,
#                                 rebuild, report, down
#   Output, failure and evidence  say, stop, and the evidence log in .lab/
#   Settings and names            terraform.tfvars and names.json
#   Safety                        the signed-in account, and the account ID typed before deletions
#   External calls                AWS CLI and Clumio API calls, and the one wait rule
#   Sample data                   the 1,000 orders and documents, the same bytes every run
#   Database                      the cluster, the RDS Data API, prepare and delete
#   Documents bucket              upload, empty and delete
#   Before an incident            Clumio's recovery points, and when an incident may start
#   The check                     what ./lab check reads, and HEALTHY or BROKEN
#   The portal                    one order at a time, in a browser
#   Record restore                the CSV Clumio returns, checked before use
#   The scorecard                 from each incident to HEALTHY

# --- Entry point ---------------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(prog="./lab", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    commands = parser.add_subparsers(dest="command", required=True)
    for name in ("preflight", "status", "check", "report", "seed", "rebuild"):
        commands.add_parser(name)
    confirm_help = "the account ID, instead of typing it (for agents); must match terraform.tfvars"
    commands.add_parser("down").add_argument("--confirm-account", help=confirm_help)
    commands.add_parser("portal").add_argument("--port", type=int, default=8080, help="the port on this computer")
    break_parser = commands.add_parser("break")
    break_parser.add_argument("incident", choices=["deploy", "everything"])
    break_parser.add_argument("--confirm-account", help=confirm_help + " (break everything only)")
    commands.add_parser("prepare").add_argument("cluster", help="the restored cluster")
    repair_from = commands.add_parser("repair").add_mutually_exclusive_group(required=True)
    repair_from.add_argument("--from", dest="source", help="the restored cluster")
    repair_from.add_argument("--from-csv", dest="csv", help="the CSV from a Clumio record restore")
    commands.add_parser("drop").add_argument("cluster", help="a restored cluster to delete")
    args = parser.parse_args()
    load_settings()
    if args.command != "report":  # report reads only the local evidence log
        confirm_signed_in_account()
    {"preflight": cmd_preflight, "status": cmd_status, "check": cmd_check, "portal": cmd_portal, "report": cmd_report,
     "seed": cmd_seed, "break": cmd_break, "prepare": cmd_prepare, "repair": cmd_repair,
     "drop": cmd_drop, "rebuild": cmd_rebuild, "down": cmd_down}[args.command](args)


# --- Commands, in the order the workshop uses them -----------------------------------------------

def cmd_preflight(_args):
    """Every environment assumption, checked before anything costs money."""
    for tool in ("terraform", "aws"):
        if not shutil.which(tool):
            stop(f"{tool} not found. Install it (see docs/0-setup.md)")
    if not run("aws", "--version").stdout.startswith("aws-cli/2."):
        stop("the AWS CLI must be version 2. Update it (see docs/0-setup.md)")
    say(f"AWS: signed in to {ACCOUNT}, Region {REGION}")  # main() confirmed the account

    default = aws("rds", "describe-db-engine-versions", "--engine", "aurora-mysql", "--default-only")
    version = default["DBEngineVersions"][0]["EngineVersion"] if default["DBEngineVersions"] else ""
    minor = re.search(r"mysql_aurora\.3\.(\d+)", version)
    if not minor or int(minor.group(1)) < 7:
        stop(f"{REGION}'s default Aurora MySQL is {version or 'unknown'}; the RDS Data API needs 3.07 or later. Choose another Region")
    say(f"Aurora MySQL default {version}: supports the RDS Data API")

    status, _ = get_clumio("/policies/definitions?limit=1")
    if status != 200:
        stop(f"Clumio refused the token or API URL (HTTP {status}). Export a new token; check CLUMIO_API_BASE_URL")
    say("Clumio: token and API URL accepted")
    clumio_regions = {r.get("id") for r in clumio_items("/connections/aws/regions?limit=100")}
    if REGION not in clumio_regions:
        stop(f"Clumio can't connect AWS Region {REGION}. Choose a Region that Clumio supports")
    say(f"Clumio: supports {REGION}")

    deployed = run("terraform", "state", "list", expect_failure=True).stdout.strip() != ""
    if not deployed:
        if is_clumio_connected():
            stop(f"{ACCOUNT} in {REGION} is already connected to Clumio. Use another test account or Region")
        if bucket_exists():
            stop(f"bucket {documents_bucket()} already exists. Delete it, or use another account")
    say("READY" + ("" if deployed else ": run terraform init && terraform apply"))


def cmd_seed(_args):
    """Loads 1,000 orders and their documents. Safe to run again: existing orders stay as they are."""
    incident = incident_since_deploy()
    if incident:  # seed is for a fresh deployment: after an incident it would blur what was recovered, and the scorecard
        stop(f"./lab seed is for a fresh deployment, and ./lab {incident} already ran in this one. "
             "To start over: ./lab down, then terraform apply")
    arn = prepare(NAMES["cluster"])
    sql(arn, "CREATE TABLE IF NOT EXISTS orders (id INT PRIMARY KEY, customer VARCHAR(80) NOT NULL, "
             "total DECIMAL(10,2) NOT NULL, status VARCHAR(20) NOT NULL, note TEXT NULL, placed_at DATETIME(3) NOT NULL, "
             "document_key VARCHAR(80) NOT NULL, document_sha256 CHAR(64) NOT NULL, INDEX by_placed_at (placed_at)) "
             "CHARACTER SET utf8mb4")
    insert_orders(arn, [order_for(i) for i in ORDER_IDS])
    os.makedirs(EVIDENCE_DIR, exist_ok=True)
    with open(SCHEMA_FILE, "w") as file:  # every later ./lab check compares the schema with this copy
        json.dump(read_schema(arn), file, indent=1)
    upload_documents({i: document_for(i) for i in ORDER_IDS})
    record("seed")
    say("Seeded 1,000 orders and 1,000 documents. Next: ./lab check")


def cmd_check(_args):
    """The recovery acceptance test. Read-only. Exit 0 only when every order has its intact document."""
    findings = {}
    orders = read_database(findings)
    documents = read_document_hashes(findings)
    healthy = judge(orders, documents, findings)
    for name, value in findings.items():
        if name == "totals":  # compare these with the archive's, in Module 4
            value = describe_totals(value)
        print(f"  {name:20} {value}")
    state = "HEALTHY" if healthy else "BROKEN"
    record("check", state=state, findings=findings)
    print(state)
    sys.exit(0 if healthy else 1)


